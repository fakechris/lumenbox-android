{
  "openapi": "3.0.3",
  "info": {
    "title": "LumenBox Client API",
    "version": "1.4.0",
    "description": "Stable /api/v1 client contract (docs/106 §4, docs/110) shared across HTTPS and multiplexed Noise_IK transports."
  },
  "paths": {
    "/api/v1/meta": {
      "get": {
        "operationId": "getMeta",
        "responses": {
          "200": {
            "description": "Server metadata and installation mode",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedServerMeta" }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "Authenticated principal summary",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedPrincipal" }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents": {
      "get": {
        "operationId": "listAgents",
        "responses": {
          "200": {
            "description": "Visible agents and whether each has an active desktop",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedAgentPage" }
              }
            }
          }
        }
      }
    },
    "/api/v1/inbox": {
      "get": {
        "operationId": "listInbox",
        "responses": {
          "200": {
            "description": "Discriminated decisions waiting on the caller",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedInboxPage" }
              }
            }
          },
          "304": { "description": "Unchanged since If-None-Match ETag" }
        }
      }
    },
    "/api/v1/approvals/{id}": {
      "post": {
        "operationId": "decideApproval",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GeneratedApprovalDecisionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Approval recorded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedActionAck" }
              }
            }
          }
        }
      }
    },
    "/api/v1/inbox/{id}/answer": {
      "post": {
        "operationId": "answerInboxItem",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GeneratedInboxAnswerRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer recorded or secret stored in vault",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedActionAck" }
              }
            }
          }
        }
      }
    },
    "/api/v1/work/{id}/decisions": {
      "post": {
        "operationId": "decideWork",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GeneratedWorkDecisionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Work decision recorded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedActionAck" }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/{seq}": {
      "get": {
        "operationId": "getNotificationSummary",
        "parameters": [
          { "name": "seq", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": {
          "200": {
            "description": "Localized notification title and summary for wake-only push",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedNotificationSummary" }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversations": {
      "get": {
        "operationId": "listConversations",
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Paged conversations",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedConversationPage" }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversations/{id}/messages": {
      "get": {
        "operationId": "listConversationMessages",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Paged committed messages in a conversation",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedMessagePage" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "sendConversationMessage",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GeneratedSendMessageRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message accepted idempotently",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedSendMessageAck" }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversations/{id}/card-actions": {
      "post": {
        "operationId": "submitCardAction",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GeneratedCardActionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ShowUI structured card action accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedActionAck" }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversations/{id}/stop": {
      "post": {
        "operationId": "stopConversationTurn",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Active turn stop requested",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedActionAck" }
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads": {
      "post": {
        "operationId": "uploadAttachment",
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": { "type": "string", "format": "binary" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Uploaded attachment descriptor",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedUploadDescriptor" }
              }
            }
          }
        }
      }
    },
    "/api/v1/work": {
      "get": {
        "operationId": "listWork",
        "parameters": [
          { "name": "state", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "agentId", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "waitsOnMe", "in": "query", "required": false, "schema": { "type": "boolean" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Paged work items",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedWorkPage" }
              }
            }
          }
        }
      }
    },
    "/api/v1/board": {
      "get": {
        "operationId": "getBoard",
        "responses": {
          "200": {
            "description": "Board columns and ordered cards",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedBoardProjection" }
              }
            }
          }
        }
      }
    },
    "/api/v1/deliverables/{id}": {
      "get": {
        "operationId": "getDeliverable",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Deliverable metadata and short-lived expiring download/preview link",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedDeliverableLink" }
              }
            }
          }
        }
      }
    },
    "/api/v1/changes": {
      "get": {
        "operationId": "getChanges",
        "parameters": [
          { "name": "since", "in": "query", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": {
          "200": {
            "description": "Durable ledger delta since durableSeq",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedChangesResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/desktops/{agentId}/tickets": {
      "post": {
        "operationId": "issueDesktopTicket",
        "parameters": [
          { "name": "agentId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GeneratedDesktopTicketRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "60-second single-use view ticket",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedDesktopTicketResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices/self/push": {
      "put": {
        "operationId": "upsertSelfDevicePush",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GeneratedDevicePushConfigRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device wake-only push capability and preferences recorded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedActionAck" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteSelfDevicePush",
        "responses": {
          "200": {
            "description": "Device wake-only push capability removed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GeneratedActionAck" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GeneratedServerMeta": {
        "type": "object",
        "required": ["api", "server"],
        "properties": {
          "api": { "type": "string" },
          "server": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "preview": { "type": "array", "items": { "type": "string" } }
        }
      },
      "GeneratedPrincipal": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" }
        }
      },
      "GeneratedAgentSummary": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "status": { "type": "string" },
          "hasDesktop": { "type": "boolean" }
        }
      },
      "GeneratedAgentPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedAgentSummary" }
          },
          "nextCursor": { "type": "string" }
        }
      },
      "GeneratedInboxPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedInboxItemWire" }
          },
          "nextCursor": { "type": "string" }
        }
      },
      "GeneratedInboxItemWire": {
        "type": "object",
        "required": ["id", "kind", "summary"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "summary": { "type": "string" },
          "toolName": { "type": "string" },
          "stepUpRequired": { "type": "boolean" },
          "channel": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } },
          "secretName": { "type": "string" },
          "workId": { "type": "string" }
        }
      },
      "GeneratedStepUpProofPayload": {
        "type": "object",
        "required": ["keyId", "approvalId", "decision", "signatureBase64Url"],
        "properties": {
          "keyId": { "type": "string" },
          "approvalId": { "type": "string" },
          "decision": { "type": "string" },
          "timestampEpochSeconds": { "type": "integer", "format": "int64" },
          "nonceBase64Url": { "type": "string" },
          "signatureBase64Url": { "type": "string" }
        }
      },
      "GeneratedApprovalDecisionRequest": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string", "enum": ["allow", "deny"] },
          "scope": { "type": "string", "enum": ["once", "session"] },
          "reason": { "type": "string" },
          "stepUpProof": { "$ref": "#/components/schemas/GeneratedStepUpProofPayload" }
        }
      },
      "GeneratedInboxAnswerRequest": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string" },
          "answer": { "type": "string" },
          "action": { "type": "string" },
          "secretName": { "type": "string" },
          "secretValue": { "type": "string" }
        }
      },
      "GeneratedWorkDecisionRequest": {
        "type": "object",
        "required": ["decision"],
        "properties": {
          "decision": { "type": "string" },
          "note": { "type": "string" }
        }
      },
      "GeneratedActionAck": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": { "type": "boolean" },
          "durableSeq": { "type": "integer", "format": "int64" }
        }
      },
      "GeneratedNotificationSummary": {
        "type": "object",
        "required": ["seq", "kind", "title", "body", "createdAt"],
        "properties": {
          "seq": { "type": "integer", "format": "int64" },
          "kind": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "createdAt": { "type": "string" },
          "inboxId": { "type": "string" },
          "conversationId": { "type": "string" },
          "workId": { "type": "string" }
        }
      },
      "GeneratedConversationSummary": {
        "type": "object",
        "required": ["id", "title", "agentId", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "agentId": { "type": "string" },
          "agentName": { "type": "string" },
          "updatedAt": { "type": "string" },
          "running": { "type": "boolean" },
          "lastMessagePreview": { "type": "string" }
        }
      },
      "GeneratedConversationPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedConversationSummary" }
          },
          "nextCursor": { "type": "string" }
        }
      },
      "GeneratedAttachmentRef": {
        "type": "object",
        "required": ["id", "name", "mimeType"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "mimeType": { "type": "string" },
          "kind": { "type": "string" },
          "sizeBytes": { "type": "integer", "format": "int64" }
        }
      },
      "GeneratedToolCallSummary": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string" },
          "summary": { "type": "string" }
        }
      },
      "GeneratedShowUiActionOption": {
        "type": "object",
        "required": ["actionId", "label"],
        "properties": {
          "actionId": { "type": "string" },
          "label": { "type": "string" },
          "style": { "type": "string" }
        }
      },
      "GeneratedShowUiCard": {
        "type": "object",
        "required": ["cardId", "title"],
        "properties": {
          "cardId": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "actions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedShowUiActionOption" }
          }
        }
      },
      "GeneratedConversationMessage": {
        "type": "object",
        "required": ["id", "conversationId", "role", "text", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "conversationId": { "type": "string" },
          "clientMessageId": { "type": "string" },
          "role": { "type": "string" },
          "text": { "type": "string" },
          "thinking": { "type": "string" },
          "createdAt": { "type": "string" },
          "attachments": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedAttachmentRef" }
          },
          "toolCalls": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedToolCallSummary" }
          },
          "cards": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedShowUiCard" }
          },
          "deliverableIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "GeneratedMessagePage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedConversationMessage" }
          },
          "nextCursor": { "type": "string" }
        }
      },
      "GeneratedSendMessageRequest": {
        "type": "object",
        "required": ["clientMessageId", "text"],
        "properties": {
          "clientMessageId": { "type": "string" },
          "text": { "type": "string" },
          "attachmentIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "GeneratedSendMessageAck": {
        "type": "object",
        "required": ["ok", "messageId", "clientMessageId"],
        "properties": {
          "ok": { "type": "boolean" },
          "messageId": { "type": "string" },
          "clientMessageId": { "type": "string" },
          "durableSeq": { "type": "integer", "format": "int64" }
        }
      },
      "GeneratedCardActionRequest": {
        "type": "object",
        "required": ["clientMessageId", "cardId", "actionId"],
        "properties": {
          "clientMessageId": { "type": "string" },
          "cardId": { "type": "string" },
          "actionId": { "type": "string" },
          "payload": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "GeneratedUploadDescriptor": {
        "type": "object",
        "required": ["attachmentId", "name", "mimeType", "sizeBytes"],
        "properties": {
          "attachmentId": { "type": "string" },
          "name": { "type": "string" },
          "mimeType": { "type": "string" },
          "kind": { "type": "string" },
          "sizeBytes": { "type": "integer", "format": "int64" },
          "durableSeq": { "type": "integer", "format": "int64" }
        }
      },
      "GeneratedWorkSummary": {
        "type": "object",
        "required": ["id", "title", "state", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "state": { "type": "string" },
          "agentId": { "type": "string" },
          "agentName": { "type": "string" },
          "conversationId": { "type": "string" },
          "waitsOnMe": { "type": "boolean" },
          "summary": { "type": "string" },
          "deliverableIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "updatedAt": { "type": "string" }
        }
      },
      "GeneratedWorkPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedWorkSummary" }
          },
          "nextCursor": { "type": "string" }
        }
      },
      "GeneratedBoardColumn": {
        "type": "object",
        "required": ["id", "title", "cards"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "cards": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedWorkSummary" }
          }
        }
      },
      "GeneratedBoardProjection": {
        "type": "object",
        "required": ["columns"],
        "properties": {
          "columns": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedBoardColumn" }
          },
          "updatedAt": { "type": "string" }
        }
      },
      "GeneratedDeliverableSummary": {
        "type": "object",
        "required": ["id", "title", "mimeType", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "mimeType": { "type": "string" },
          "sizeBytes": { "type": "integer", "format": "int64" },
          "workId": { "type": "string" },
          "conversationId": { "type": "string" },
          "createdAt": { "type": "string" }
        }
      },
      "GeneratedDeliverableLink": {
        "type": "object",
        "required": ["id", "title", "mimeType", "url", "expiresAt"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "mimeType": { "type": "string" },
          "sizeBytes": { "type": "integer", "format": "int64" },
          "url": { "type": "string" },
          "expiresAt": { "type": "string" },
          "inlinePreviewText": { "type": "string" }
        }
      },
      "GeneratedChangesResponse": {
        "type": "object",
        "required": ["durableSeq"],
        "properties": {
          "durableSeq": { "type": "integer", "format": "int64" },
          "hasMore": { "type": "boolean" },
          "conversations": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedConversationSummary" }
          },
          "messages": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedConversationMessage" }
          },
          "removedConversationIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "inbox": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedInboxItemWire" }
          },
          "work": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedWorkSummary" }
          },
          "deliverables": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GeneratedDeliverableSummary" }
          }
        }
      },
      "GeneratedDesktopTicketRequest": {
        "type": "object",
        "required": ["mode"],
        "properties": {
          "mode": { "type": "string", "enum": ["view"] }
        }
      },
      "GeneratedDesktopTicketResponse": {
        "type": "object",
        "required": ["ticket", "path", "expiresInSeconds"],
        "properties": {
          "ticket": { "type": "string" },
          "path": { "type": "string" },
          "wsUrl": { "type": "string" },
          "expiresInSeconds": { "type": "integer" }
        }
      },
      "GeneratedQuietHoursWindow": {
        "type": "object",
        "required": ["startLocalTime", "endLocalTime", "timezone"],
        "properties": {
          "startLocalTime": { "type": "string" },
          "endLocalTime": { "type": "string" },
          "timezone": { "type": "string" }
        }
      },
      "GeneratedDevicePushPreferences": {
        "type": "object",
        "required": ["level"],
        "properties": {
          "level": {
            "type": "string",
            "enum": ["needs-you-only", "needs-you-and-completions", "off"]
          },
          "quietHours": { "$ref": "#/components/schemas/GeneratedQuietHoursWindow" }
        }
      },
      "GeneratedDevicePushConfigRequest": {
        "type": "object",
        "required": ["pushToken", "connId", "preferences"],
        "properties": {
          "pushToken": { "type": "string" },
          "connId": { "type": "string" },
          "channel": { "type": "string" },
          "preferences": { "$ref": "#/components/schemas/GeneratedDevicePushPreferences" }
        }
      }
    }
  }
}
